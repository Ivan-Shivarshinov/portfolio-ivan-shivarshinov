---
// Tag.astro — моно-лейбл-тег (R3): рамка 1px var(--color-line) на surface.
// theme-проп выставляет --project-accent на корне через inline style (R5,
// Pattern 2): без theme — ноль акцента (нейтральный покой D-08), с theme —
// текст и рамка в проектном акценте. Значения hex живут в tokens.css;
// компонент содержит только маппинг enum → var() (check-tokens).
interface Props {
  label: string;
  theme?: 'terracotta' | 'clay' | 'olive' | 'slate' | 'plum';
  size?: 'sm' | 'md';
}

const { label, theme, size = 'sm' } = Astro.props;

const ACCENTS: Record<'terracotta' | 'clay' | 'olive' | 'slate' | 'plum', string> = {
  terracotta: 'var(--color-accent)',
  clay: 'var(--project-clay)',
  olive: 'var(--project-olive)',
  slate: 'var(--project-slate)',
  plum: 'var(--project-plum)',
};
---

<span
  class={`tag tag--${size}`}
  style={theme ? { '--project-accent': ACCENTS[theme] } : undefined}
>
  {label}
</span>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.4;
    color: var(--project-accent, var(--color-ink-muted));
    background: var(--color-surface);
    border: 1px solid var(--project-accent, var(--color-line)); /* 1px — вне шкалы, разрешено */
    transition:
      color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard);
  }
  .tag:hover {
    border-color: var(--color-ink);
  }
  .tag--sm {
    padding: var(--space-xs) var(--space-sm);
  }
  .tag--md {
    padding: var(--space-sm) var(--space-md);
  }
</style>
