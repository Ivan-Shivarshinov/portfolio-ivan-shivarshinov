---
// Footer.astro — структурный футер оболочки (D-03): одна моно-строка
// «© 2026 · Иван Шиваршинов» + Latin-метка раздела (HOME/WORK/...),
// тонкая верхняя граница 1px var(--color-line). Ссылки и колонки — фаза 3.
interface Props {
  sectionLabel: string;
}

const { sectionLabel } = Astro.props;
---

<footer class="footer">
  <div class="footer__row">
    <span>© 2026 · Иван Шиваршинов</span>
    <span class="footer__section">{sectionLabel}</span>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line); /* 1px — вне шкалы, разрешено */
    padding-block: var(--space-md);
  }
  .footer__row {
    display: flex;
    justify-content: space-between;
    gap: var(--space-md);
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter-mobile);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    line-height: 1.4;
    color: var(--color-ink-muted);
  }
  .footer__section {
    text-transform: uppercase;
  }
  @media (min-width: 768px) {
    .footer__row {
      padding-inline: var(--gutter-desktop);
    }
  }
</style>
