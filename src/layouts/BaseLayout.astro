---
// BaseLayout — общий каркас страниц: head-контракт делегируется Seo.astro,
// тело — <slot /> для плоского списка self-closing компонентов (D-04).
// Оболочка фазы 2: <Nav /> + <Footer /> вместо inline-разметки; моно-метка
// страницы (D-05) над контентом; контейнер: max-width var(--container-max),
// gutter var(--gutter-mobile) → var(--gutter-desktop) на ≥768px (R6).
import '../styles/tokens.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  pageLabel?: string;
}

const { title, description, pageLabel } = Astro.props;
// Latin-метка раздела для Footer: последний сегмент метки («01 / HOME» → 'HOME').
const sectionLabel = pageLabel?.split(' ').at(-1);
---
<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={title} description={description} />
  </head>
  <body>
    <header class="shell__header">
      <Nav />
    </header>
    <main class="shell__main">
      {pageLabel && <p class="page-label">{pageLabel}</p>}
      <slot />
    </main>
    {sectionLabel && <Footer sectionLabel={sectionLabel} />}
  </body>
</html>

<style>
  /* Общий контейнер оболочки: header и main — одна колонка на контракте R6 */
  .shell__header,
  .shell__main {
    max-width: var(--container-max);
    margin-inline: auto;
    padding-inline: var(--gutter-mobile);
  }
  @media (min-width: 768px) {
    .shell__header,
    .shell__main {
      padding-inline: var(--gutter-desktop);
    }
  }
  .shell__main {
    padding-block: var(--space-xl) var(--space-3xl);
  }
  /* Моно-метка страницы «01 / HOME» над контентом (D-05) */
  .page-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    line-height: 1.4;
    color: var(--color-ink-muted);
    margin-block: 0 var(--space-lg);
  }
</style>
